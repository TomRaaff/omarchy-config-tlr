(defcfg
  input   (device-file "/dev/input/by-path/pci-0000:00:14.0-usb-0:5:1.1-event-kbd")
  output  (uinput-sink "KMonad: Macbook AIR kbd")
  fallthrough true
  allow-cmd true
)


(defalias
  caps    (tap-next esc lctl)
  lay2    (tap-next f (layer-toggle LAYER2))
  fn      (around (layer-toggle FUNC) fn)
)

(defsrc
  esc     f1      f2      f3      f4      f5      f6      f7      f8      f9      f10     f11     f12
  grv     1       2       3       4       5       6       7       8       9       0       -       =       bspc
  tab     q       w       e       r       t       y       u       i       o       p       [       ]       \
  caps    a       s       d       f       g       h       j       k       l       ;       '       ret
  lsft    z       x       c       v       b       n       m       ,       .       /       rsft
  fn      lctl    lalt    lmet                    spc                     rmet    ralt    left    up      down    rght
)

(deflayer default
  esc     brdn    brup    lp      mctl    bldn    blup    prev    pp      next    mute    vold    volu
  grv     1       2       3       4       5       6       7       8       9       0       -       =       bspc
  tab     q       w       e       r       t       y       u       i       o       p       [       ]       \
  @caps   a       s       d       @lay2   g       h       j       k       l       ;       '       ret
  lsft    z       x       c       v       b       n       m       ,       .       /       rsft
  @fn     lctl    lalt    lmet                    spc                     rmet    ralt    left    up      down    rght
)

(deflayer LAYER2
  _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       left    down    up      rght    _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _
  @fn     lctl    lalt    lmet                    spc                     rmet    ralt    left    up      down    rght
)

(deflayer FUNC
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _    _    _    _    _    _    _    _    _    del
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _              _              _    _    _    _    _
)

